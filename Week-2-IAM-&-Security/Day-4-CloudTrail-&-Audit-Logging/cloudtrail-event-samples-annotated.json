    "userName": "my-admin-user"
  },
  "eventTime": "2024-09-15T10:28:47Z",
  "eventSource": "iam.amazonaws.com",
  "eventName": "DeleteUser",
  "awsRegion": "us-east-1",
  "sourceIPAddress": "197.210.52.8",
  "requestParameters": {
    "userName": "test-cloudtrail-user"             // The user that was deleted
  },
  "responseElements": null,                        // null on success for destructive ops
  "readOnly": false,
