// ---- SAMPLE 1: CreateUser event ----
// Source: IAM (global service) → logged in us-east-1
{
  "eventVersion": "1.08",
  "userIdentity": {
    "type": "IAMUser",                              // WHO: type of principal
    "principalId": "AIDAIOSFODNN7EXAMPLE",
    "arn": "arn:aws:iam::123456789012:user/my-admin-user",  // WHO: full ARN
    "accountId": "123456789012",
    "userName": "my-admin-user"                     // WHO: human-readable name
  },
  "eventTime": "2024-09-15T10:14:23Z",             // WHEN: UTC timestamp
  "eventSource": "iam.amazonaws.com",              // WHICH service received the call
  "eventName": "CreateUser",                        // WHAT: specific API action
  "awsRegion": "us-east-1",                        // NOTE: IAM = global = always us-east-1
  "sourceIPAddress": "197.210.52.8",               // WHERE: originating IP (Lagos)
  "userAgent": "AWS Console",                      // HOW: console vs CLI vs SDK
  "requestParameters": {
    "userName": "test-cloudtrail-user"             // INPUTS: what was passed to the API
  },
  "responseElements": {
    "user": {                                       // RESULT: the created user object
      "userName": "test-cloudtrail-user",
      "userId": "AIDAIOSFODNN7EXAMPLE2",
      "arn": "arn:aws:iam::123456789012:user/test-cloudtrail-user",
      "createDate": "Sep 15, 2024 10:14:23 AM"
    }
  },
  "requestID": "F2A8E7C1D9B3EXAMPLE",
  "eventID": "3a4b5c6d-7e8f-4a2b-91c3-example",   // UNIQUE: event identifier
  "readOnly": false,                               // false = write/mutating operation
  "eventType": "AwsApiCall",
  "managementEvent": true,                         // true = management event (default captured)
  "recipientAccountId": "123456789012"
}


// ---- SAMPLE 2: DeleteUser event ----
