// ---- SAMPLE 4: FAILED action — Access Denied ----
// What a denied action looks like — errorCode and errorMessage present
{
  "userIdentity": {
    "type": "IAMUser",
    "arn": "arn:aws:iam::123456789012:user/analyst-user",
    "userName": "analyst-user"
  },
  "eventTime": "2024-09-15T11:02:33Z",
  "eventSource": "s3.amazonaws.com",
  "eventName": "CreateBucket",
  "awsRegion": "af-south-1",
  "sourceIPAddress": "197.210.52.8",
  "requestParameters": {
    "bucketName": "attempted-new-bucket"
  },
  "responseElements": null,
  "errorCode": "AccessDenied",                     // FAILED: IAM policy blocked it
  "errorMessage": "User: arn:aws:iam::123456789012:user/analyst-user is not authorized to perform: s3:CreateBucket",
  "readOnly": false,
  "managementEvent": true
}
// Key: errorCode "AccessDenied" means IAM blocked it BEFORE any resource was created.
// Both successful AND denied API calls are logged — critical for security investigations.


// ---- SAMPLE 5: ConsoleLogin event ----
// Appears in Event History almost immediately (within ~2 minutes)
// IAM global service → always in us-east-1 folder
{
  "userIdentity": {
    "type": "IAMUser",
    "arn": "arn:aws:iam::123456789012:user/my-admin-user",
    "userName": "my-admin-user",
    "accountId": "123456789012"
  },
  "eventTime": "2024-09-15T09:47:12Z",
  "eventSource": "signin.amazonaws.com",           // NOTE: sign-in service, not iam.amazonaws.com
  "eventName": "ConsoleLogin",
  "awsRegion": "us-east-1",
  "sourceIPAddress": "197.210.52.8",               // Your IP — verify this matches yours
  "userAgent": "Mozilla/5.0 ...",
  "requestParameters": null,
  "responseElements": {
    "ConsoleLogin": "Success"                      // "Failure" appears here for wrong password
  },
  "additionalEventData": {
    "LoginTo": "https://console.aws.amazon.com/",
    "MobileVersion": "No",
    "MFAUsed": "Yes"                               // Confirm MFA was active for this login
  },
  "managementEvent": true
}
